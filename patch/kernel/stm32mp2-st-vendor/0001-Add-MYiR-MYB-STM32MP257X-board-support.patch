+ * Copyright (C) MYiR 2024 - All Rights Reserved
+ */
+
+/dts-v1/;
+
+#define		ETH_SWITCH_ENABLE  		1
+#define		LVDS_7INCH_PANEL		1
+
+#include "myb-stm32mp257x-base.dtsi"
+#include "myb-stm32mp257x-1GB-resmem.dtsi"
+#include "myb-stm32mp257x-ethswitch.dtsi"
+
+/ {
+	model = "MYiR MYB-STM32MP257X 1GB (ethswitch)";
+	compatible = "myir,myb-stm32mp257x-ethswitch", "myir,myb-stm32mp257x", "st,stm32mp257";
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x0 0x40000000>;
+	};
+
+};
+
