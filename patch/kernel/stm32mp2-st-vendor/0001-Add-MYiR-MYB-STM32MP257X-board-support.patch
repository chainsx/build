+/* YT8531S board support: RGMII delay configuration and LED registers */
+#define YT8521_EXTREG_LED1				0xA00D
+#define YT8521_EXTREG_LED2				0xA00E
+#define YT8531S_EXTREG_RGMII_DELAY_CFG			0xA003
+#define YT8531S_EXTREG_SYNCE_CFG			0xA012
+#define YT8531S_SYNCE_CFG_CLK_OUT_EN			BIT(6)
+
+static int yt8531s_delay_init(struct phy_device *phydev)
+{
+	struct device_node *np = phydev->mdio.dev.of_node;
+	u32 delay_cfg;
+	int ret;
+
+	/*
+	 * Boards may provide a vendor-tuned raw value for extended register
+	 * 0xA003 (RGMII RXC/TXC delay configuration) through the device tree.
+	 */
+	if (!of_property_read_u32(np, "ytphy_delay_cfg", &delay_cfg)) {
+		ret = ytphy_write_ext(phydev, YT8531S_EXTREG_RGMII_DELAY_CFG,
+				      delay_cfg);
+		if (ret < 0)
+			return ret;
+
+		return 0;
+	}
+
+	/* Fall back to the standard delay-ps properties handling */
+	return ytphy_rgmii_clk_delay_config(phydev);
+}
+
+static int yt8531s_led_init(struct phy_device *phydev)
+{
+	int ret;
+
+	/* Do not drive the SyncE clock on the LED pin */
+	ret = ytphy_modify_ext(phydev, YT8531S_EXTREG_SYNCE_CFG,
+			       YT8531S_SYNCE_CFG_CLK_OUT_EN, 0);
+	if (ret < 0)
+		return ret;
+
+	/* LED1: on when link is up at 10/100/1000 Mbps */
+	ret = ytphy_write_ext(phydev, YT8521_EXTREG_LED1, 0x10f);
+	if (ret < 0)
+		return ret;
+
+	/* LED2: blinks on RX/TX activity */
+	return ytphy_write_ext(phydev, YT8521_EXTREG_LED2, 0x70);
+}
