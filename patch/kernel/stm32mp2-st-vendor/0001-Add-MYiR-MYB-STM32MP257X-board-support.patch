From: Armbian STM32MP2-ST <build@armbian.org>
Subject: [PATCH] Add MYiR MYB-STM32MP257X board support (device trees and drivers)

---
diff --git a/Documentation/devicetree/bindings/arm/stm32/stm32.yaml b/Documentation/devicetree/bindings/arm/stm32/stm32.yaml
index 808036450..36486d531 100644
--- a/Documentation/devicetree/bindings/arm/stm32/stm32.yaml
+++ b/Documentation/devicetree/bindings/arm/stm32/stm32.yaml
@@ -14,6 +14,20 @@ properties:
     const: "/"
   compatible:
     oneOf:
+      - description: MYiR MYB-STM32MP257X Boards
+        oneOf:
+          - items:
+              - const: myir,myb-stm32mp257x
+              - const: st,stm32mp257
+          - items:
+              - const: myir,myb-stm32mp257x
+              - const: st,stm32mp257f-ev1
+              - const: st,stm32mp257
+          - items:
+              - const: myir,myb-stm32mp257x-ethswitch
+              - const: myir,myb-stm32mp257x
+              - const: st,stm32mp257
+
       - description: emtrion STM32MP1 Argon based Boards
         items:
           - const: emtrion,stm32mp157c-emsbc-argon
diff --git a/Documentation/devicetree/bindings/net/motorcomm,yt8xxx.yaml b/Documentation/devicetree/bindings/net/motorcomm,yt8xxx.yaml
index 26688e230..236ce73a2 100644
--- a/Documentation/devicetree/bindings/net/motorcomm,yt8xxx.yaml
+++ b/Documentation/devicetree/bindings/net/motorcomm,yt8xxx.yaml
@@ -52,6 +52,13 @@ properties:
       for a timer.
     type: boolean
 
+  ytphy_delay_cfg:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: |
+      Vendor defined raw value for the YT8531S RGMII RXC/TXC delay
+      configuration extended register 0xA003. When present, it takes
+      precedence over rx-internal-delay-ps / tx-internal-delay-ps.
+
   motorcomm,rx-clk-drv-microamp:
     description: |
       drive strength of rx_clk rgmii pad.
diff --git a/MAINTAINERS b/MAINTAINERS
index e88e526bb..cce9453dc 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -2788,6 +2788,14 @@ F:	drivers/usb/host/ohci-st.c
 F:	drivers/watchdog/st_lpc_wdt.c
 F:	include/linux/remoteproc/st_slim_rproc.h
 
+ARM/MYIR MYB-STM32MP257X BOARD SUPPORT
+M:	beste wang <beste.wang@myir.cn>
+L:	linux-stm32@st-md-mailman.stormreply.com (moderated for non-subscribers)
+L:	linux-arm-kernel@lists.infradead.org (moderated for non-subscribers)
+S:	Maintained
+F:	arch/arm64/boot/dts/st/myb-stm32mp257x*
+F:	arch/arm64/configs/myb_stm32mp257x_defconfig
+
 ARM/STM32 ARCHITECTURE
 M:	Maxime Coquelin <mcoquelin.stm32@gmail.com>
 M:	Alexandre Torgue <alexandre.torgue@foss.st.com>
