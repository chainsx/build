+static void myb_phy_reset_toggle(ofnode node, const char *prop)
+{
+	struct gpio_desc gpio;
+
+	gpio_request_by_name_nodev(node, prop, 0, &gpio, GPIOD_IS_OUT);
+	if (!dm_gpio_is_valid(&gpio))
+		return;
+
+	dm_gpio_set_value(&gpio, 1);	/* assert reset */
+	mdelay(12);
+	dm_gpio_set_value(&gpio, 0);	/* release reset */
+	mdelay(10);
+	dm_gpio_free(NULL, &gpio);
+}
+
+static void board_myb_phy_reset(void)
+{
+	static const char * const phy_compat[] = { "ethernet-phy1",
+						    "ethernet-phy2" };
+	static const char * const reset_props[] = { "reset-gpios",
+						    "phy-gpios",
+						    "reset2-gpios" };
+	ofnode node;
+	int i, j;
+
+	for (i = 0; i < ARRAY_SIZE(phy_compat); i++) {
+		node = ofnode_by_compatible(ofnode_null(), phy_compat[i]);
+		if (!ofnode_valid(node))
+			continue;
+
+		for (j = 0; j < ARRAY_SIZE(reset_props); j++)
+			myb_phy_reset_toggle(node, reset_props[j]);
+	}
+}
+
+static void board_myb_stm32mp257x_init(void)
+{
+	struct udevice *dev;
+
+	/* keep the green user LED off, blue LED is the boot indicator */
+	if (!get_led(&dev, "user-led0"))
+		led_set_state(dev, LEDST_OFF);
+
+	/* panel and HDMI bridge auto-detection, shared with ST boards */
+	board_stm32mp25x_eval_init();
+
+	/* YT8531S PHYs need a reset pulse after power up */
+	board_myb_phy_reset();
+}
+
