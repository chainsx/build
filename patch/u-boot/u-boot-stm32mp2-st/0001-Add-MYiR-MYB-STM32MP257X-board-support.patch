+++ b/include/configs/myb_stm32mp257x.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later OR BSD-3-Clause */
+/*
+ * Copyright (C) 2024, MYiR - All Rights Reserved
+ *
+ * Configuration settings for the MYiR MYB-STM32MP257X boards
+ * (1GB and 2GB LPDDR4 variants), on top of the ST STM32MP25x
+ * common configuration.
+ */
+
+#ifndef __CONFIG_MYB_STM32MP257X_H__
+#define __CONFIG_MYB_STM32MP257X_H__
+
+#include <configs/stm32mp25_common.h>
+
+/*
+ * MYB-STM32MP257X loads the kernel lower in DRAM than ST EV boards,
+ * keep the layout used by the MYiR boot chain (FWU A/B on eMMC/SD).
+ */
+#undef __KERNEL_ADDR_R
+#define __KERNEL_ADDR_R		__stringify(0x88000000)
+
+#include <configs/stm32mp25_st_common.h>
+
+#undef STM32MP_BOARD_EXTRA_ENV
+#define STM32MP_BOARD_EXTRA_ENV \
+	"usb_pgood_delay=2000\0" \
+	"loglevel=3\0" \
+	"console=ttySTM0\0"
+
+#ifdef CFG_EXTRA_ENV_SETTINGS
+#undef CFG_EXTRA_ENV_SETTINGS
+#define CFG_EXTRA_ENV_SETTINGS \
+	STM32MP_MEM_LAYOUT \
+	ST_STM32MP25_BOOTCMD \
+	BOOTENV \
+	STM32MP_EXTRA \
+	STM32MP_BOARD_EXTRA_ENV
+#endif
+
+#endif /* __CONFIG_MYB_STM32MP257X_H__ */
